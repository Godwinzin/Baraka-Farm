# Copy this file to .env and fill in the values. Never commit .env.

# Neon connection string for your development branch (pooled)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# Optional locally; the server uses 3000 if it's empty
PORT=3000

# Email notifications (Resend). Leave empty to skip sending emails.
RESEND_API_KEY=
NOTIFY_EMAIL=

# Only set on the Render service: where to redirect stray visitors
# FRONTEND_URL=https://your-project.vercel.app